{
  "name": "bucketbook",
  "version": "1.11.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "bash scripts/e2e.sh",
    "db:reset": "docker compose -f docker-compose.dev.yml exec -T postgres psql -q -v ON_ERROR_STOP=1 -c \"set client_min_messages=warning\" -U bucketbook -d bucketbook -c \"drop schema public cascade; create schema public; drop schema if exists drizzle cascade; drop schema if exists pgboss cascade;\"",
    "seed:demo": "tsx --env-file-if-exists=.env.local scripts/seed-demo.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.2",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
