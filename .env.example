# Bucketbook configuration. Copy to `.env` and fill in the values:
#
#   cp .env.example .env
#
# Generate each secret with:  openssl rand -base64 32
# Never commit your .env file.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The full address people type to open the app. Used for login cookies and
# to block requests from other sites. Examples:
#   http://192.168.1.20:9951            (plain LAN access)
#   https://books.example.com           (behind a reverse proxy like Caddy)
APP_URL=http://localhost:9951

# Signs login sessions. At least 32 characters. Changing it signs everyone out.
BETTER_AUTH_SECRET=

# Encrypts stored bank credentials (the SimpleFIN Access URL). Must be exactly
# 32 random bytes as base64. If you lose it, you must reconnect SimpleFIN.
APP_ENCRYPTION_KEY=

# Password for the bundled Postgres database (docker compose only).
# Use letters and digits only, since it goes inside a URL:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Where the database files (data/postgres) and receipts (data/receipts) live,
# relative to this folder. Leave it as is so backing up this folder backs up
# everything (docker compose only).
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Port on the host where the app is published (docker compose only).
APP_PORT=9951

# The app image. The default follows every 1.x release; pin one release with,
# for example, ghcr.io/cbik6/bucketbook:1.0.0
# BUCKETBOOK_IMAGE=ghcr.io/cbik6/bucketbook:1

# Build from a copy of the source code instead (see docker-compose.build.yml):
# COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml

# Database name and user for the bundled Postgres (docker compose only).
POSTGRES_USER=bucketbook
POSTGRES_DB=bucketbook

# Other addresses that may also be used to open the app, comma separated.
# Example: you normally use https://books.example.com but sometimes the LAN IP.
TRUSTED_ORIGINS=

# Time zone for timestamps in the activity log and for "today" defaults, for example
# America/Chicago. Defaults to UTC.
TZ=UTC

# Nightly database backups (docker compose only): a gzipped pg_dump such as
# backups/bucketbook-2026-11-20.sql.gz, made at BACKUP_TIME (24-hour, in TZ above).
# The newest BACKUP_KEEP_DAYS are kept. BACKUP_DIR can point elsewhere, for
# example a NAS mount, but the default keeps backups inside this folder.
BACKUP_TIME=02:00
BACKUP_KEEP_DAYS=14
# BACKUP_DIR=./backups

# Maximum database connections the app opens. Keep small on low-memory hosts.
DB_POOL_MAX=5

# Run the background job queue (bank sync, rules). Leave on.
JOBS_ENABLED=true

# ---------------------------------------------------------------------------
# Only when running outside docker compose (npm run dev / npm start)
# ---------------------------------------------------------------------------

# docker compose builds this for you from the POSTGRES_* values above.
# DATABASE_URL=postgres://bucketbook:bucketbook@localhost:5433/bucketbook

# Where uploaded receipts are stored. docker compose uses DATA_DIR/receipts.
# RECEIPTS_DIR=./data/receipts

# Extra hosts allowed to load the dev server's assets, comma separated
# (for example the LAN IP of your dev machine). Only used by `npm run dev`.
# DEV_ALLOWED_ORIGINS=
